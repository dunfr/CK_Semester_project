{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "d4c46b1dd1b34d149b356d3fa8b4d4bb",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "DoubleRingThickness (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1920,
            "y": 240,
            "width": 260,
            "height": 180
        }
    },
    "m_Slots": [
        {
            "m_Id": "55133ad930534058934d01b8df9cf9a2"
        },
        {
            "m_Id": "25854e90a2f84341a87f9aa18f311254"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "DoubleRingThickness",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Remap radial distance around the original ring radius to double only its width.\nfloat2 offset = UV - float2(0.5, 0.5);\nfloat radius = length(offset);\nfloat ringRadius = 0.33984375;\nfloat sampleRadius = ringRadius + (radius - ringRadius) * 0.5;\nOut = float2(0.5, 0.5) + offset * (sampleRadius / max(radius, 0.00001));"
}

